{
  "name": "boomerang-pvp-relay",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit && esbuild relay.ts stats-report.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outdir=dist --out-extension:.js=.mjs",
    "start": "node dist/relay.mjs",
    "stats": "node dist/stats-report.mjs"
  },
  "dependencies": {
    "ip2region": "4.0.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.13",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  }
}
