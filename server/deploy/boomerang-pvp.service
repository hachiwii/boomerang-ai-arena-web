[Unit]
Description=Boomerang PvP relay
After=network.target

[Service]
Type=simple
User=boomerang-pvp
Group=boomerang-pvp
WorkingDirectory=/opt/boomerang-pvp
Environment=NODE_ENV=production
EnvironmentFile=-/etc/boomerang-pvp.env
ExecStart=/usr/bin/node /opt/boomerang-pvp/dist/relay.mjs
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Per-match latency stats → /var/lib/boomerang-pvp/stats (STATE_DIRECTORY); the IP-region database adds ~110 MB
StateDirectory=boomerang-pvp
StateDirectoryMode=0750
MemoryHigh=320M
MemoryMax=450M

[Install]
WantedBy=multi-user.target
