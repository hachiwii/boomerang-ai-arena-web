# Copy to .env.production.local (gitignored) and fill in your values.
# None of these values should be committed to git.

# Optional ICP filing number shown in the lobby footer (links to https://beian.miit.gov.cn/)
VITE_ICP_NUMBER=

# Alibaba Cloud deployment target (used by scripts/deploy_aliyun.sh)
DEPLOY_DOMAIN=
DEPLOY_OSS_BUCKET=
DEPLOY_OSS_REGION=cn-hangzhou
