# Copy to .env.production.local (gitignored) and fill in your values.
# None of these values should be committed to git.

# Optional ICP filing number shown in the lobby footer (links to https://beian.miit.gov.cn/)
VITE_ICP_NUMBER=

# Alibaba Cloud deployment target (used by scripts/deploy_aliyun.sh)
DEPLOY_DOMAIN=
DEPLOY_OSS_BUCKET=
DEPLOY_OSS_REGION=cn-hangzhou

# Online PvP (1v1 via the relay in server/). On by default; VITE_PVP_ENABLED=0 hides it (e.g. on a mirror site).
# VITE_PVP_URL is the relay's public WebSocket URL, e.g. wss://pvp.example.com/ws. Unset: ws(s)://<page host>:8787/ws,
# i.e. the relay running on the same machine as the site (ws:// on http pages, wss:// on https pages).
VITE_PVP_ENABLED=
VITE_PVP_URL=
